{
  "schemaVersion": 1,
  "description": "Agent-driven application acceptance via UVE (code, bundle, health, optional gate). Copy into YOUR app repo as config/uve/agent-app-workflow.manifest.json and edit paths.",
  "trainingPipelineRootManifestRelativePath": "config/emulator-workstation/uve-emulator-pipeline-root.json",
  "workstationContextRelativeToLocalAppData": "EmulatorWorkstation/logs/verification/context.json",
  "applicationContractRelativePath": "config/uve/application.json",
  "errorRegistryRelativePath": "config/uve/uve-error-registry.manifest.json",
  "repairActorRef": "YOUR_REPAIR_ACTOR",
  "gateEvaluatorRef": "uve_gate",
  "applicationGateId": "application_acceptance",
  "probeSequence": [
    "application_code",
    "application_bundle",
    "application_health"
  ],
  "optionalProbeIds": [
    "application_feature_ui_flow"
  ],
  "plannedUserFlowSpecsRelativePath": "docs/plans/uve-user-flows/plan.MD",
  "invariantSeverityManifestRelativePath": "config/uve/uve-invariant-severity.manifest.json",
  "releaseRequiredFlowsManifestRelativePath": "config/uve/uve-release-required-flows.manifest.json",
  "metroReloadScriptRelativePath": "logs/verification/metro-reload/reload-app.cjs",
  "healthProbeId": "application_health",
  "healthRetryAfterReload": true,
  "debugOnFailure": {
    "application_code": [
      "Read probe receipt in training_pipeline/logs/uve/probes/{probe_run_id}.json",
      "Run the command declared in config/uve/application.json code_probe from repo root"
    ],
    "application_bundle": [
      "Ensure dev server is running on the port from Workstation context.json",
      "Re-run bundle probe command from application.json"
    ],
    "application_health": [
      "If stale JS: run metro reload script once, then retry application_health",
      "Inspect failure_class and failure_selectors; fix runtime error and re-probe"
    ]
  },
  "reporting": {
    "receiptGlob": "logs/uve/probes/*.json",
    "requireProbeRunIdsInSummary": true
  }
}
