  "ingest_ref": "config/uve_triage_ingest_manifest.json",
  "summary_ref": "config/uve_triage_summary_manifest.json",
  "fingerprint_ref": "config/uve_triage_fingerprint_manifest.json",
  "retention_ref": "config/uve_triage_retention_manifest.json",
  "adapter_ref": "config/uve_triage_adapter_manifest.json",
  "lifecycle_catalog_ref": "config/uve_triage_lifecycle_catalog.json",
  "comparison_ref": "config/uve_triage_comparison_manifest.json",
  "proof_ref": "config/uve_triage_proof_manifest.json",
  "storage_lifecycle_ref": "config/uve_storage_lifecycle_manifest.json",
