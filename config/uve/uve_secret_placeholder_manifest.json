{
  "schema_version": "uve_secret_placeholder_manifest.v1",
  "patterns": [
    {
      "pattern_id": "bearer_jwt",
      "token_kind": "auth_bearer",
      "regex": "Bearer\\s+[A-Za-z0-9._\\-+/=]+",
      "placeholder_template": "Bearer <AUTH_TOKEN_{instance}>"
    },
    {
      "pattern_id": "api_key_kv",
      "token_kind": "api_key",
      "regex": "(?i)(api[_-]?key\\s*[:=]\\s*)[A-Za-z0-9._\\-]+",
      "placeholder_template": "\\1<API_KEY_{instance}>"
    }
  ]
}
