{
  "schema_version": "uve_ui_flow.v1",
  "generated_from": "config/community-feed-uve.manifest.json",
  "steps": [
    {
      "step_id": "boot_completed",
      "kind": "shell_property",
      "property": "sys.boot_completed",
      "expected": "1"
    },
    {
      "step_id": "foreground_package",
      "kind": "shell_dump_window",
      "assertion": "package_present",
      "package_substring_ref": "config/uve/targets/protrainer/guest_package.json"
    },
    {
      "step_id": "ensure_main_tabs",
      "kind": "navigation_recovery",
      "policy_ref": "config/uve/targets/protrainer/navigation_recovery_main_tabs.json"
    },
    {
      "step_id": "open_community_tab",
      "kind": "tap_element",
      "selector": {
        "resource-id": "mobile-tab-community"
      }
    },
    {
      "step_id": "community_feed_visible",
      "kind": "assert_element",
      "selector": {
        "text": "Community"
      }
    },
    {
      "step_id": "expand_post_composer",
      "kind": "tap_element",
      "selector": {
        "resource-id": "community-feed-composer-compact"
      }
    },
    {
      "step_id": "post_input_visible",
      "kind": "assert_element",
      "selector": {
        "resource-id": "community-feed-post-input"
      }
    },
    {
      "step_id": "tap_add_photo",
      "kind": "tap_element",
      "selector": {
        "resource-id": "community-feed-add-photo"
      }
    },
    {
      "step_id": "image_picker_ready",
      "kind": "assert_element",
      "selector": {
        "text": "Photos"
      }
    },
    {
      "step_id": "image_picker_activity_visible",
      "kind": "assert_activity",
      "expected_substring": "com.android.photopicker.MainActivity"
    },
    {
      "step_id": "dismiss_image_picker",
      "kind": "keyevent",
      "keycode": 4
    },
    {
      "step_id": "composer_still_visible_after_picker_cancel",
      "kind": "assert_element",
      "selector": {
        "resource-id": "community-feed-post-input"
      }
    }
  ]
}
