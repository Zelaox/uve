{
  "schema_version": "uve_ui_flow.v1",
  "generated_from": "config/membership-hub-uve.manifest.json",
  "steps": [
    {
      "step_id": "boot_completed",
      "kind": "shell_property",
      "property": "sys.boot_completed",
      "expected": "1"
    },
    {
      "step_id": "foreground_package",
      "kind": "shell_dump_window",
      "assertion": "package_present",
      "package_substring_ref": "config/uve/targets/protrainer/guest_package.json"
    },
    {
      "step_id": "focus_community_tab_for_header",
      "kind": "tap_element",
      "selector": {
        "resource-id": "mobile-tab-community"
      }
    },
    {
      "step_id": "open_profile_settings",
      "kind": "tap_element",
      "selector": {
        "content-desc": "Settings"
      }
    },
    {
      "step_id": "scroll_settings_to_subscription",
      "kind": "swipe",
      "coordinates": [
        640,
        2200,
        640,
        600
      ],
      "duration_ms": 500
    },
    {
      "step_id": "open_subscription_from_settings",
      "kind": "tap_element",
      "selector": {
        "resource-id": "membership-settings-manage-entry"
      }
    },
    {
      "step_id": "membership_hub_visible",
      "kind": "assert_element",
      "selector": {
        "resource-id": "membership-hub-root"
      }
    },
    {
      "step_id": "membership_summary_visible",
      "kind": "assert_element",
      "selector": {
        "resource-id": "membership-hub-subscription"
      }
    },
    {
      "step_id": "buy_real_pro_button_visible",
      "kind": "assert_element",
      "selector": {
        "resource-id": "membership-hub-buy-real-pro"
      }
    },
    {
      "step_id": "tap_buy_real_pro",
      "kind": "tap_element",
      "selector": {
        "resource-id": "membership-hub-buy-real-pro"
      }
    },
    {
      "step_id": "play_billing_activity_visible",
      "kind": "assert_activity",
      "expected_substring": "ProxyBillingActivity"
    },
    {
      "step_id": "dismiss_play_billing_sheet",
      "kind": "keyevent",
      "keycode": 4
    },
    {
      "step_id": "buy_real_pro_still_available_after_cancel",
      "kind": "assert_element",
      "selector": {
        "resource-id": "membership-hub-buy-real-pro"
      }
    }
  ]
}
