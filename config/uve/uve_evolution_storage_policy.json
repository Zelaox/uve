{
  "schema_version": "ailab.uve.evolution_storage_policy.v1",
  "database_relative_from_lab": "logs/uve/expansion_store.sqlite",
  "schema_sql_ref": "config/uve/uve_evolution_storage_schema.sql",
  "evidence_hold_policy_ref": "config/uve/uve_evolution_evidence_hold_policy.json",
  "wal_mode": true,
  "busy_timeout_ms": 30000,
  "evaluation_detail_retention_generations": 20,
