{
  "schema_version": "uve_evidence_storage_manifest.v1",
  "store_relative": "logs/uve/evidence",
  "default_deny": true,
  "roles": [
    {
      "role_id": "uve_runner",
      "capabilities": ["read_raw", "write_raw"]
    },
    {
      "role_id": "uve_gate",
      "capabilities": ["read_raw"]
    },
    {
      "role_id": "export_service",
      "capabilities": ["read_raw", "run_export_transform"]
    },
    {
      "role_id": "operator",
      "capabilities": ["read_raw", "write_raw"]
    },
    {
      "role_id": "repair_agent",
      "capabilities": []
    }
  ],
  "enforce_os_acl": true
}
